{
  "ConnectionStrings": {
    "SqlServer": "Server=localhost,1433;Database=BlogMonitor;User Id=sa;Password=MyPassword@123;TrustServerCertificate=true;Encrypt=false;"
  },
  "Jwt": {
    "SecretKey": "SET_IN_USER_SECRETS",
    "Issuer": "BlogMonitorApi",
    "Audience": "BlogMonitorClient",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "SmtpHost": "smtp-mail.outlook.com",
    "SmtpPort": 587,
    "SenderEmail": "SET_IN_USER_SECRETS",
    "SenderPassword": "SET_IN_USER_SECRETS"
  },
  "Storage": {
    "BasePath": "C:\\BlogMonitorStorage"
  },
  "Scheduler": {
    "DailyCron": "0 2 * * *"
  },
  "Scraper": {
    "PageTimeoutSeconds": 30,
    "DelayBetweenPagesSeconds": 2,
    "MaxRetries": 3,
    "TrackBMaxUrls": 20,
    "TrackBPathFilter": "/blog,/article,/post,/news"
  },
  "Summarizer": {
    "MinSentences": 3,
    "MaxSentences": 7,
    "MinContentWords": 50
  }
}
